# skill/voice-transcription — local whisper.cpp config (paths assume host install)
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
WHISPER_LANGUAGE=de

# skill/github-app — the bot's GitHub App (private key at ~/agent-keys/github-app.pem)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Group folders that get the GitHub tool, comma-separated (e.g. telegram_main,telegram_jan)
GITHUB_ENABLED_FOLDERS=
# Repository names (without owner) each installation token is scoped to, comma-separated
GITHUB_REPOSITORIES=
